__pycache__/
.env
.venv
.claude
.pytest_cache
.uv-cache
.lavish/
# Screenshots the mandatory UI review step writes; regenerable, never committed.
.playwright-cli/

# Scoring runs are local working artifacts by default. A milestone run is a
# directory named <date>-<label>/ and is committed with its lineage manifest
# (#757); everything else under evals/runs/ stays local.
evals/runs/*
!evals/runs/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*/
!evals/runs/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*/**

# Raw probe observations. ADR-0060 records the reviewed verdicts, not this file:
# it is regenerated by the reproduction command in that record, and a committed
# copy would silently go stale against the schema the probe reads.
v0_sql_path_probe.json

# crew-mode runtime state (briefs, statuses, events, watcher bookkeeping)
.crew/[0-9]*-*.md
.crew/[0-9]*-task.json
.crew/[0-9]*-heartbeat.json
.crew/events.log
.crew/.watch-state.json
.crew/candidates.json

# crew-mode VS Code auto-launch queue (dispatch requests and result event logs)
.crew/launch-queue/
