# Serves the agent: both profiles select deepseek in config/settings.yaml. No free tier.
DEEPSEEK_API_KEY="your-deepseek-api-key"
# Only needed when agent.provider (or a profile) is switched back to groq.
GROQ_API_KEY="your-groq-api-key"
GOOGLE_API_KEY="your-google-api-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
# The Langfuse Cloud host of the project D-029 chose. Copy it from that project's
# settings page rather than guessing a region. There is no code default: a missing
# value disables tracing with a named reason instead of exporting to a local
# address nobody serves.
LANGFUSE_BASE_URL="https://<your-langfuse-cloud-host>"
# Local traces use this environment. Render sets it to `production` in render.yaml.
LANGFUSE_TRACING_ENVIRONMENT="local"
# Optional local release attribution. Render's automatic RENDER_GIT_COMMIT takes precedence.
# LANGFUSE_RELEASE="your-git-commit-sha"
DATABASE_URL="postgresql+psycopg://internhunter:internhunter@localhost:5433/internhunter"
# HEALTHCHECKS_URL="https://hc-ping.com/<uuid>"   # dead-man ping; optional, skipped locally
