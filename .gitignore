__pycache__/
.env
.venv
.claude
.pytest_cache
.uv-cache
.deepeval/
.deepeval-cache.json
# Scoring runs are local working artifacts by default; dated calibration evidence
# referenced by an ADR is re-included explicitly so it lands in review.
evals/runs/*
!evals/runs/iha266-calibration-v7-judge-scores.json
!evals/runs/iha266-calibration-v7-agreement-report.json
!evals/runs/iha346-calibration-v8-judge-scores.json
!evals/runs/iha346-calibration-v8-agreement-report.json
!evals/runs/iha358-indirect-injection.json
!evals/runs/iha358-indirect-injection-execution.json
!evals/runs/iha358-indirect-injection-grade.json
!evals/runs/iha-v8-judge-combined-judge-scores.json
!evals/runs/iha-v8-judge-combined-agreement-report.json
.lavish/

# Agent-skill installs whose docs reference artifacts created by later workflows
.agents/skills/deepeval/

# Regenerable local viewer HTML (evidence lives in the committed replay JSON)
evals/replays/*-viewer.html

# crew-mode runtime state (briefs, statuses, events, watcher bookkeeping)
.crew/[0-9]*-*.md
.crew/[0-9]*-task.json
.crew/[0-9]*-heartbeat.json
.crew/events.log
.crew/.watch-state.json
.crew/candidates.json

# crew-mode VS Code auto-launch queue (dispatch requests and result event logs)
.crew/launch-queue/

.no-mistakes/
